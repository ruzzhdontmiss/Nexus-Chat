# ── Managed AI Provider (Nexus Free Tier) ─────────────────────────────────────
# Groq is the current managed provider powering nexus/free/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here

# ── BYOK Provider Keys (optional — users connect their own via /providers) ─────
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Legacy / additional providers (optional)
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Credential Encryption ──────────────────────────────────────────────────────
# AES-256-GCM key for encrypting BYOK credentials at rest (32 bytes = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXUS_CREDENTIAL_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Authentication (NextAuth / Auth.js) ────────────────────────────────────────
AUTH_SECRET=your_nextauth_secret_here
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# ── Nexus Free Tier Limits ─────────────────────────────────────────────────────
NEXUS_FREE_ENABLED=true
NEXUS_FREE_DAILY_REQUEST_LIMIT=20
NEXUS_FREE_DAILY_TOKEN_LIMIT=100000
NEXUS_FREE_MAX_OUTPUT_TOKENS=2000
NEXUS_FREE_MAX_CONTEXT_TOKENS=8000

# ── Rate Limits (per user per minute) ─────────────────────────────────────────
NEXUS_CHAT_RATE_LIMIT_PER_MINUTE=20
NEXUS_SEARCH_RATE_LIMIT_PER_MINUTE=10

# ── Web Search (Tavily) ────────────────────────────────────────────────────────
# Get a free key at https://tavily.com — leave blank to disable search
NEXUS_SEARCH_API_KEY=
NEXUS_SEARCH_ENABLED=true
NEXUS_DAILY_SEARCH_LIMIT=50

# ── RAG / Document Ingestion ───────────────────────────────────────────────────
# Optional limits for uploaded RAG documents
NEXUS_MAX_DOCUMENT_SIZE_MB=10
NEXUS_MAX_CHUNKS_PER_USER=1000

# ── Database ───────────────────────────────────────────────────────────────────
# Pooled connection URL (used by the app at runtime)
DATABASE_URL=postgres://user:pass@localhost:5432/nexus
# Direct (unpooled) connection URL — required for Prisma migrations
DATABASE_URL_UNPOOLED=postgres://user:pass@localhost:5432/nexus
