# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY="your-mistral-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# Credential Encryption Key (32 bytes hex = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXUS_CREDENTIAL_ENCRYPTION_KEY="your-64-char-hex-key-here"

# Nexus Free Configuration
NEXUS_FREE_ENABLED=true
NEXUS_FREE_DAILY_REQUEST_LIMIT=20
NEXUS_FREE_DAILY_TOKEN_LIMIT=100000
NEXUS_FREE_MAX_OUTPUT_TOKENS=2000
NEXUS_FREE_MAX_CONTEXT_TOKENS=8000

# Authentication
AUTH_SECRET="your-nextauth-secret-here"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Database
# Note: Local Postgres URL or Prisma Postgres URL
DATABASE_URL="postgres://user:pass@localhost:5432/nexus"
